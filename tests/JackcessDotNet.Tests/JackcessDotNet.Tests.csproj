<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xUnit.net v3: a test project is its own runner, so it is an executable. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- mtp-off: xUnit.net v3 without Microsoft Testing Platform, so `dotnet test` runs it through VSTest
         on every SDK. The default xunit.v3 package cannot be run that way on the .NET 10 SDK. -->
    <PackageReference Include="xunit.v3.mtp-off"       Version="4.0.3"  />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\JackcessDotNet\JackcessDotNet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="IndexKeys\general-legacy-ace16.tsv" LogicalName="JackcessDotNet.Tests.general-legacy-ace16.tsv" />
  </ItemGroup>
</Project>
