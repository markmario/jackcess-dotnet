<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xUnit.net v3: a test project is its own runner, so it is an executable. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit.net v3 on Microsoft Testing Platform: global.json tells `dotnet test` to use it. -->
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\JackcessDotNet\JackcessDotNet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="IndexKeys\general-legacy-ace16.tsv" LogicalName="JackcessDotNet.Tests.general-legacy-ace16.tsv" />
    <EmbeddedResource Include="IndexKeys\general-legacy-more-ace16.tsv" LogicalName="JackcessDotNet.Tests.general-legacy-more-ace16.tsv" />
    <EmbeddedResource Include="IndexKeys\general-ace16.tsv" LogicalName="JackcessDotNet.Tests.general-ace16.tsv" />
    <!-- Databases earlier releases of this library wrote (LegacyLongKeyTests, tools/legacy-long-keys.ps1), and an
         Access 97 one that Jet 4.0 wrote (Access97ReadTests, tools/access97-fixture.ps1). -->
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
