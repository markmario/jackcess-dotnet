<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net472;netstandard2.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>JackcessDotNet</RootNamespace>
    <AssemblyName>JackcessDotNet</AssemblyName>
    <!-- The package ID is not the assembly name: nuget.org's JackcessDotNet is the upstream port's
         package (net10.0 only), so this one has an ID of its own. The assembly and namespace stay
         JackcessDotNet, so code written against either reads the same. -->
    <PackageId>Jackcess.Net</PackageId>
    <!-- The release tag is the version: CI passes -p:Version from a vX.Y.Z tag (scripts/Assert-ReleaseTag.ps1),
         and the assembly, file and package versions all follow it. This is only the untagged default, so a
         local or branch build is plainly not a release and cannot shadow a published package in
         ~/.nuget/packages. Do not edit it to cut a release. -->
    <Version>0.0.0-local</Version>
    <!-- The floor a release tag is checked against. A breaking change to the public API raises it to the
         next major in the same change, so it cannot ship as a minor or patch release. 2.0.0 because the
         public API has changed since upstream's 1.2.2, where this repository started. -->
    <MinimumReleaseVersion>2.0.0</MinimumReleaseVersion>
    <Description>Pure managed library for reading and writing Microsoft Access (.mdb and .accdb) files, for .NET 8, .NET Framework 4.7.2 and .NET Standard 2.0, with no ACE or ODBC driver. A port of the Jackcess Java library whose files are checked against Access's own engine.</Description>
    <Authors>markmario; Mehran Ghanizadeh</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Optimize>true</Optimize>
    <LangVersion>latest</LangVersion>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
    <PackageTags>access;mdb;accdb;jet;jackcess;database</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>jackcess.png</PackageIcon>

    <!-- GitHub linkage: surfaces "Project website" + "Source repository" on the nuget.org package page -->
    <PackageProjectUrl>https://github.com/markmario/jackcess-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/markmario/jackcess-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink: lets consumers step into this library's source on GitHub from their debugger -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- nuget.org shows this under "Release Notes"; the full history ships in CHANGELOG.md. -->
    <PackageReleaseNotes>See CHANGELOG.md in the package, or https://github.com/markmario/jackcess-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md"     Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE"       Pack="true" PackagePath="\" />
    <!-- Apache-2.0 section 4: the licence and the attribution notices travel with every copy. -->
    <None Include="..\..\NOTICE"        Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md"  Pack="true" PackagePath="\" />
    <None Include="..\..\jackcess.png"  Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET (Core) only: .NET Framework has the legacy code pages in-box, and this
         package's Unsafe 6.x dependency breaks redirect-free xcopy deployment there
         (see the NETFRAMEWORK guard in JetFormat.InitEncodings). -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0"
                      Condition="'$(TargetFramework)' != 'net472' AND '$(TargetFramework)' != 'netstandard2.0'" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- The public API is recorded in PublicAPI.Shipped.txt (what a release has
       published) and PublicAPI.Unshipped.txt (what has changed since), and the
       build fails when the code and the files disagree: a public type or member
       added, changed or removed shows as a diff of those files. The three target
       frameworks have the same API, so they share one pair of files.
       The version is pinned here because this repository builds on its own,
       with no central package management. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <PropertyGroup>
    <!-- RS0016/RS0017: an API that is not recorded, or a recorded one that is gone.
         RS0036/RS0037/RS0041: nullability is part of what is recorded.
         RS0022: a constructor that would let a caller derive from a class.
         RS0024/RS0025/RS0048/RS0050: the files themselves are wrong. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037;RS0041;RS0048;RS0050</WarningsAsErrors>
    <!-- RS0026/RS0027 object to overloads with optional parameters, which the API
         as recorded already has (ColumnBuilder, CreateTable, ImportTable): they
         would report every build without saying anything about a change. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <!-- net472 support: framework references plus packages backfilling BCL types
       (Span/Memory/BinaryPrimitives, ValueTuple, HashCode). See Compat/. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472' OR '$(TargetFramework)' == 'netstandard2.0'">
    <Reference Include="System.ComponentModel.DataAnnotations" Condition="'$(TargetFramework)' == 'net472'" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <!-- Source-generates language-support polyfills (Index/Range, required
         members, init-only setters, ...) for down-level targets. -->
    <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="All" />
  </ItemGroup>

  <!-- Only when unsigned: a strong-named assembly needs a public key in every
       InternalsVisibleTo. Consumers that sign this project (e.g. embedding it in
       a strong-named library) don't build the test project, so they don't need it. -->
  <ItemGroup Condition="'$(SignAssembly)' != 'true'">
    <InternalsVisibleTo Include="JackcessDotNet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\\empty2003.mdb" />
    <!-- Made by DAO (tools/empty-databases.ps1), not copied from Jackcess: see DatabaseHeader. -->
    <EmbeddedResource Include="Resources\\empty2007.accdb" />
    <EmbeddedResource Include="Resources\\empty2010.accdb" />
    <EmbeddedResource Include="Resources\\index_codes_genleg.txt" />
    <EmbeddedResource Include="Resources\\index_codes_ext_genleg.txt" />
    <EmbeddedResource Include="Resources\\index_codes_gen.txt" />
    <EmbeddedResource Include="Resources\\index_codes_ext_gen.txt" />
  </ItemGroup>

</Project>
